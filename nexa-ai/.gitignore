# ========================================================
# NEXA AI - Root .gitignore
# ========================================================

# Compiled Java class files
*.class

# Log files
*.log
*.log.*
logs/
log/

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Virtual Machine crash logs
hs_err_pid*
replay_pid*

# Maven
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# Gradle (if any)
.gradle/
build/

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Eclipse
.apt_generated/
.apt_generated_tests/
.classpath
.factorypath
.project
.settings/
.springBeans
.recommenders/

# Visual Studio Code
.vscode/
*.code-workspace

# NetBeans
nbproject/private/
nbbuild/
dist/
nbproject/genfiles.properties
build.xml

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# NEXA AI Application Uploads & Runtime Data
uploads/
**/uploads/
!docker/uploads/.gitkeep
storage/
temp/
tmp/
*.tmp

# Sensitive Keys & Environment Variables
.env
.env.local
.env.*.local
*.pem
*.key
*.pkcs12
*.p12
*.jks
credentials.json
secrets.yml
secrets.properties

# Database storage
*.db
*.sqlite
*.sqlite3
*.h2.db
data/
mysql_data/

# ========================================================
# NEXA AI - Backend Multi-Stage Dockerfile
# Stage 1: Build Application with Maven & Temurin JDK 21
# Stage 2: Minimal Distroless / Alpine Runtime with JRE 21
# ========================================================

# Stage 1: Build
FROM maven:3.9.9-eclipse-temurin-21-alpine AS builder

WORKDIR /build

# Copy root POM and module POMs first for dependency caching
COPY pom.xml ./
COPY nexa-common/pom.xml ./nexa-common/
COPY nexa-security/pom.xml ./nexa-security/
COPY nexa-ai-engine/pom.xml ./nexa-ai-engine/
COPY nexa-document-engine/pom.xml ./nexa-document-engine/
COPY nexa-backend/pom.xml ./nexa-backend/
COPY nexa-desktop/pom.xml ./nexa-desktop/

# Copy all source files
COPY nexa-common/src ./nexa-common/src
COPY nexa-security/src ./nexa-security/src
COPY nexa-ai-engine/src ./nexa-ai-engine/src
COPY nexa-document-engine/src ./nexa-document-engine/src
COPY nexa-backend/src ./nexa-backend/src

# Build nexa-backend and required dependencies (excluding nexa-desktop UI)
RUN mvn clean package -DskipTests -pl nexa-backend -am --no-transfer-progress

# Stage 2: Production Runtime
FROM eclipse-temurin:21-jre-alpine AS runner

LABEL maintainer="NEXA AI Team <admin@nexa.ai>"
LABEL description="NEXA AI Enterprise Backend Service"
LABEL version="1.0.0"

# Install curl for healthcheck probe
RUN apk add --no-cache curl tzdata

# Create dedicated application user and group
RUN addgroup -S nexa && adduser -S nexa -G nexa

WORKDIR /app

# Create upload directory and set ownership
RUN mkdir -p /app/uploads && chown -R nexa:nexa /app

# Copy packaged executable jar from builder stage
COPY --from=builder /build/nexa-backend/target/nexa-backend-*.jar /app/app.jar
RUN chown nexa:nexa /app/app.jar

# Switch to non-root user
USER nexa

# Environment variables
ENV SPRING_PROFILES_ACTIVE=prod \
    SERVER_PORT=8080 \
    JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC -XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0"

# Expose backend API port
EXPOSE 8080

# Healthcheck
HEALTHCHECK --interval=20s --timeout=5s --start-period=45s --retries=5 \
    CMD curl -f http://localhost:8080/actuator/health || exit 1

# Launch application
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]

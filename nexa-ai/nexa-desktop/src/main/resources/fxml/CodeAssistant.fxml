<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true" styleClass="scroll-pane">
    <VBox spacing="20">
        <padding>
            <Insets top="24" right="32" bottom="32" left="32" />
        </padding>

        <HBox alignment="CENTER_LEFT" spacing="16">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="%nav.code_assistant" styleClass="section-title" />
                <Label text="AI-powered code generation, automated refactoring, and security vulnerability scanning." styleClass="text-muted" />
            </VBox>
            <ComboBox prefWidth="160" promptText="Language: Java 21" />
            <Button text="Execute / Audit" styleClass="btn-primary" />
        </HBox>

        <HBox spacing="16">
            <!-- Source Editor -->
            <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="card-pane" style="-fx-padding: 16;">
                <Label text="Source Code Input" style="-fx-font-weight: bold;" styleClass="text-main" />
                <TextArea prefRowCount="14" promptText="// Paste your Java, Python, TypeScript or SQL code here..."
                          style="-fx-font-family: 'Consolas', 'Courier New', monospace;" />
            </VBox>

            <!-- Analysis & Output -->
            <VBox spacing="8" HBox.hgrow="ALWAYS" styleClass="card-pane" style="-fx-padding: 16;">
                <Label text="AI Intelligence Analysis" style="-fx-font-weight: bold;" styleClass="text-main" />
                <TextArea prefRowCount="14" editable="false" promptText="AI suggestions, complexity audit, and optimized implementation will appear here."
                          style="-fx-font-family: 'Consolas', 'Courier New', monospace;" />
            </VBox>
        </HBox>
    </VBox>
</ScrollPane>

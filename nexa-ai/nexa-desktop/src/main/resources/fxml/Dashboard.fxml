<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nexa.desktop.controller.DashboardController"
            fitToWidth="true"
            styleClass="scroll-pane">

    <VBox spacing="24">
        <padding>
            <Insets top="24" right="32" bottom="32" left="32" />
        </padding>

        <!-- Welcome Banner -->
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="card-pane"
              style="-fx-background-color: linear-gradient(to right, #1D212B, #272B38); -fx-padding: 24; -fx-border-color: #3B4257;">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label fx:id="welcomeTitleLabel" text="Welcome back, Agent 👋"
                       style="-fx-font-size: 20px; -fx-font-weight: bold;" styleClass="text-main" />
                <Label fx:id="welcomeSubtitleLabel" text="%dashboard.subtitle"
                       styleClass="text-muted" style="-fx-font-size: 13px;" />
            </VBox>
            <Button text="%dashboard.action_new_chat" onAction="#onQuickNewChat" styleClass="btn-primary" />
        </HBox>

        <!-- Metrics Row -->
        <HBox spacing="16">
            <!-- Metric 1: Conversations -->
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" spacing="8">
                <Label text="%dashboard.metric_conversations" styleClass="metric-title" />
                <Label fx:id="metricConversationsLabel" text="0" styleClass="metric-value" />
                <Label text="+18% this month" styleClass="text-muted" style="-fx-font-size: 10px; -fx-text-fill: -nexa-secondary;" />
            </VBox>

            <!-- Metric 2: Tokens -->
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" spacing="8">
                <Label text="%dashboard.metric_tokens" styleClass="metric-title" />
                <Label fx:id="metricTokensLabel" text="0" styleClass="metric-value" />
                <Label text="Across 5 active providers" styleClass="text-muted" style="-fx-font-size: 10px;" />
            </VBox>

            <!-- Metric 3: Models -->
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" spacing="8">
                <Label text="%dashboard.metric_models" styleClass="metric-title" />
                <Label fx:id="metricModelsLabel" text="5" styleClass="metric-value" />
                <Label text="GPT-4o, Claude 3.5, Gemini" styleClass="text-muted" style="-fx-font-size: 10px;" />
            </VBox>

            <!-- Metric 4: Latency -->
            <VBox styleClass="metric-card" HBox.hgrow="ALWAYS" spacing="8">
                <Label text="%dashboard.metric_latency" styleClass="metric-title" />
                <Label fx:id="metricLatencyLabel" text="240 ms" styleClass="metric-value" />
                <Label text="Ultra-fast streaming" styleClass="text-muted" style="-fx-font-size: 10px; -fx-text-fill: -nexa-secondary;" />
            </VBox>
        </HBox>

        <!-- Quick Launch Actions Section -->
        <VBox spacing="12">
            <Label text="%dashboard.quick_actions" styleClass="section-title" />

            <HBox spacing="14">
                <!-- Action 1: New Chat -->
                <VBox styleClass="action-card" HBox.hgrow="ALWAYS" spacing="6" onMouseClicked="#onQuickNewChat">
                    <Label text="💬" style="-fx-font-size: 22px;" />
                    <Label text="%dashboard.action_new_chat" styleClass="action-card-title" />
                    <Label text="%dashboard.action_new_chat_desc" styleClass="action-card-desc" wrapText="true" />
                </VBox>

                <!-- Action 2: Summarize Doc -->
                <VBox styleClass="action-card" HBox.hgrow="ALWAYS" spacing="6" onMouseClicked="#onQuickSummarizeDoc">
                    <Label text="📄" style="-fx-font-size: 22px;" />
                    <Label text="%dashboard.action_summarize" styleClass="action-card-title" />
                    <Label text="%dashboard.action_summarize_desc" styleClass="action-card-desc" wrapText="true" />
                </VBox>

                <!-- Action 3: Explain Code -->
                <VBox styleClass="action-card" HBox.hgrow="ALWAYS" spacing="6" onMouseClicked="#onQuickExplainCode">
                    <Label text="⚡" style="-fx-font-size: 22px;" />
                    <Label text="%dashboard.action_explain_code" styleClass="action-card-title" />
                    <Label text="%dashboard.action_explain_code_desc" styleClass="action-card-desc" wrapText="true" />
                </VBox>

                <!-- Action 4: Analyze File -->
                <VBox styleClass="action-card" HBox.hgrow="ALWAYS" spacing="6" onMouseClicked="#onQuickAnalyzeFile">
                    <Label text="📊" style="-fx-font-size: 22px;" />
                    <Label text="%dashboard.action_analyze_file" styleClass="action-card-title" />
                    <Label text="%dashboard.action_analyze_file_desc" styleClass="action-card-desc" wrapText="true" />
                </VBox>

                <!-- Action 5: Project -->
                <VBox styleClass="action-card" HBox.hgrow="ALWAYS" spacing="6" onMouseClicked="#onQuickAiProject">
                    <Label text="🚀" style="-fx-font-size: 22px;" />
                    <Label text="%dashboard.action_project" styleClass="action-card-title" />
                    <Label text="%dashboard.action_project_desc" styleClass="action-card-desc" wrapText="true" />
                </VBox>
            </HBox>
        </VBox>

        <!-- Recent Conversations Section -->
        <VBox spacing="12">
            <HBox alignment="CENTER_LEFT">
                <Label text="%dashboard.recent_activity" styleClass="section-title" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="%action.refresh" onAction="#onRefreshDashboard" styleClass="btn-secondary-sm" />
            </HBox>

            <VBox fx:id="recentListContainer" spacing="8" styleClass="card-pane" style="-fx-padding: 16;">
                <Label fx:id="emptyConversationsLabel" text="%dashboard.no_recent"
                       styleClass="text-muted" alignment="CENTER" maxWidth="Infinity" style="-fx-padding: 24;" />
            </VBox>
        </VBox>

    </VBox>
</ScrollPane>

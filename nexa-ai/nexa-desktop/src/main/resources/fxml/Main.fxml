<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nexa.desktop.controller.MainController"
            styleClass="main-window"
            prefWidth="1280.0" prefHeight="820.0">

    <!-- Left Sidebar -->
    <left>
        <VBox styleClass="sidebar" prefWidth="230.0" spacing="12">
            <padding>
                <Insets top="18" right="12" bottom="18" left="12" />
            </padding>

            <!-- Brand Header -->
            <HBox alignment="CENTER_LEFT" spacing="10">
                <padding>
                    <Insets top="4" right="8" bottom="12" left="8" />
                </padding>
                <StackPane prefWidth="32" prefHeight="32" maxWidth="32" maxHeight="32">
                    <Circle radius="16" fill="#7167F8" />
                    <Label text="NX" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 12px;" />
                </StackPane>
                <VBox spacing="1">
                    <Label text="NEXA AI" style="-fx-font-size: 15px; -fx-font-weight: bold;" styleClass="text-main" />
                    <Label text="Enterprise v1.0" style="-fx-font-size: 10px;" styleClass="text-muted" />
                </VBox>
            </HBox>

            <!-- Navigation Items Scroll -->
            <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
                <VBox spacing="4">
                    <Button fx:id="btnDashboard" text="%nav.dashboard" onAction="#onNavDashboard"
                            maxWidth="Infinity" styleClass="sidebar-button, sidebar-button-active" />
                    <Button fx:id="btnChat" text="%nav.chat" onAction="#onNavChat"
                            maxWidth="Infinity" styleClass="sidebar-button" />
                    <Button fx:id="btnDocuments" text="%nav.documents" onAction="#onNavDocuments"
                            maxWidth="Infinity" styleClass="sidebar-button" />
                    <Button fx:id="btnCodeAssistant" text="%nav.code_assistant" onAction="#onNavCodeAssistant"
                            maxWidth="Infinity" styleClass="sidebar-button" />
                    <Button fx:id="btnProjects" text="%nav.projects" onAction="#onNavProjects"
                            maxWidth="Infinity" styleClass="sidebar-button" />
                    <Button fx:id="btnFiles" text="%nav.files" onAction="#onNavFiles"
                            maxWidth="Infinity" styleClass="sidebar-button" />
                    <Button fx:id="btnAnalytics" text="%nav.analytics" onAction="#onNavAnalytics"
                            maxWidth="Infinity" styleClass="sidebar-button" />

                    <Region prefHeight="16" />
                    <Label text="SYSTEM" style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 0 0 4 8;" styleClass="text-muted" />

                    <Button fx:id="btnSettings" text="%nav.settings" onAction="#onNavSettings"
                            maxWidth="Infinity" styleClass="sidebar-button" />
                    <Button fx:id="btnAdmin" text="%nav.admin" onAction="#onNavAdmin"
                            maxWidth="Infinity" styleClass="sidebar-button" />
                </VBox>
            </ScrollPane>

            <!-- Bottom User Profile Pill -->
            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="card-pane" style="-fx-padding: 10;">
                <StackPane prefWidth="30" prefHeight="30" maxWidth="30" maxHeight="30">
                    <Circle radius="15" fill="#374151" />
                    <Label text="U" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 11px;" />
                </StackPane>
                <VBox spacing="1" HBox.hgrow="ALWAYS">
                    <Label fx:id="userDisplayNameLabel" text="User" style="-fx-font-size: 12px; -fx-font-weight: bold;" styleClass="text-main" />
                    <Label fx:id="userEmailLabel" text="user@nexa.ai" style="-fx-font-size: 10px;" styleClass="text-muted" />
                </VBox>
                <Button fx:id="logoutButton" text="🚪" onAction="#onLogout" styleClass="btn-icon" style="-fx-font-size: 11px;" />
            </HBox>
        </VBox>
    </left>

    <!-- Center Content with Header -->
    <center>
        <BorderPane>
            <!-- Top Status Bar -->
            <top>
                <HBox alignment="CENTER_LEFT" spacing="16" styleClass="top-bar" prefHeight="56.0">
                    <padding>
                        <Insets top="8" right="24" bottom="8" left="24" />
                    </padding>

                    <!-- Active Screen Title -->
                    <Label fx:id="screenTitleLabel" text="Dashboard Overview" styleClass="section-title" />

                    <Region HBox.hgrow="ALWAYS" />

                    <!-- Backend Connection Status Indicator -->
                    <HBox alignment="CENTER" spacing="6" styleClass="badge-secondary">
                        <Circle fx:id="connectionStatusDot" radius="4" fill="#22C7A9" />
                        <Label fx:id="connectionStatusLabel" text="%header.connected" style="-fx-font-size: 11px; -fx-font-weight: bold;" />
                    </HBox>

                    <!-- Theme Toggle -->
                    <Button fx:id="themeToggleButton" text="🌓" onAction="#onToggleTheme" styleClass="btn-icon" />
                </HBox>
            </top>

            <!-- Dynamic Content Stack Pane -->
            <center>
                <StackPane fx:id="contentPane" styleClass="content-pane" />
            </center>
        </BorderPane>
    </center>

</BorderPane>

            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="recent-item-card" style="-fx-padding: 12;">
                <Label text="🤖" style="-fx-font-size: 20px;" />
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="Anthropic Claude" style="-fx-font-weight: bold;" styleClass="text-main" />
                    <Label text="API Key: sk-ant-...5k2E • Base URL: https://api.anthropic.com/v1 • Status: Healthy" styleClass="text-muted" style="-fx-font-size: 11px;" />
                </VBox>
                <Button text="Test" styleClass="btn-secondary-sm" />
                <Button text="Edit" styleClass="btn-secondary-sm" />
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="recent-item-card" style="-fx-padding: 12;">
                <Label text="🤖" style="-fx-font-size: 20px;" />

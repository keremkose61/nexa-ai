            <Label text="Configured AI Providers" style="-fx-font-weight: bold; -fx-font-size: 14px;" styleClass="text-main" />

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="recent-item-card" style="-fx-padding: 12;">
                <Label text="🤖" style="-fx-font-size: 20px;" />
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label text="OpenAI (Default Provider)" style="-fx-font-weight: bold;" styleClass="text-main" />
                    <Label text="API Key: sk-proj-...8a1F • Base URL: https://api.openai.com/v1 • Status: Healthy" styleClass="text-muted" style="-fx-font-size: 11px;" />
                </VBox>
                <Button text="Test" styleClass="btn-secondary-sm" />
